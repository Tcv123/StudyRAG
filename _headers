# Cloudflare Pages response headers. Copied into dist/ by the build.
#
# Both folders hold files whose URL changes whenever their content does
# (scripts/fingerprint-assets.js and scripts/split-papers-config.js), so
# browsers can keep them without ever asking the server again. Everything
# else keeps Pages' default of checking for a newer copy on each load.

/static/*
  Cache-Control: public, max-age=31536000, immutable

/papers-data/*
  Cache-Control: public, max-age=31536000, immutable

# Baseline security headers on every response. SAMEORIGIN rather than DENY:
# the subject-notes/ pages show notes and PDFs in an iframe of this site,
# which DENY would blank. Cloudflare merges this with the blocks above.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
