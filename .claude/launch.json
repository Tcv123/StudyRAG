{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "PowerShell static server",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".claude/serve.ps1",
        "-Port",
        "8000"
      ],
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "Python3 HTTP server",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server"
      ],
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "npx serve (static)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        ".",
        "--no-clipboard"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Python HTTP server",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server"
      ],
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "distress-api",
      "runtimeExecutable": "/Users/tharun/Desktop/Distress Dection Engine/backend/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000",
        "--app-dir",
        "/Users/tharun/Desktop/Distress Dection Engine/backend"
      ],
      "port": 8000
    },
    {
      "name": "distress-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "/Users/tharun/Desktop/Distress Dection Engine/frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
